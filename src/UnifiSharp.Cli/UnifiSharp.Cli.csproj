<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>unifisharp</ToolCommandName>
    <PackageId>UnifiSharp.Cli</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>CLI for UnifiSharp — read and discover UniFi Network from the shell.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../UnifiSharp/UnifiSharp.csproj" />
  </ItemGroup>

</Project>
