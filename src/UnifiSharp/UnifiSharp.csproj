<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Independent SemVer for the hand-written surface; decoupled from the
         UniFi API version (UnifiSharp.Api). -->
    <VersionPrefix>0.2.0</VersionPrefix>
    <!-- Public nuget.org ID uses the reserved Chrison.* prefix (the bare
         'UnifiSharp' ID is taken on nuget.org by an unrelated project).
         AssemblyName/RootNamespace stay 'UnifiSharp' (project name) so consumer
         code — `using UnifiSharp;` — is unchanged. -->
    <PackageId>Chrison.UnifiSharp</PackageId>
    <Description>C# client for UniFi Network — hand-written runtime over the generated Chrison.UnifiSharp.Api.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../UnifiSharp.Api/UnifiSharp.Api.csproj" />
  </ItemGroup>

</Project>
